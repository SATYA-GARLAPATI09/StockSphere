# Server Port
PORT=5000
NODE_ENV=development

# Primary Database (MongoDB)
# Local: mongodb://localhost:27017/stocksphere
# Cloud Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/stocksphere?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/stocksphere

# Knowledge Graph (Neo4j)
# Local Desktop/Community: bolt://localhost:7687
# Cloud Aura: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# JWT Authentication
JWT_SECRET=stocksphere_super_secret_jwt_key_2026_academic_lab_exam
JWT_EXPIRES_IN=8h

# CORS Whitelist (Frontend Vite Dev Server)
CLIENT_ORIGIN=http://localhost:5173
